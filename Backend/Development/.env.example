# FastAPI Configuration
ENV=development
HOST=0.0.0.0
PORT=8000

# S3 Configuration
BUCKET_NAME=assessment-drafting-engine

# DynamoDB Configuration (drafts / auto-save persistence)
DYNAMODB_TABLE=paper-drafts

# AWS Credentials (required for S3 access)
# Option 1: Set here (not recommended for security)
# AWS_ACCESS_KEY_ID=your-access-key-id
# AWS_SECRET_ACCESS_KEY=your-secret-access-key

# Option 2: Use AWS credentials file at ~/.aws/credentials
# Option 3: Use IAM role (if running on EC2/ECS)

AWS_DEFAULT_REGION=us-east-1

# Application Settings
LOG_LEVEL=INFO
CORS_ORIGINS=*

# S3 Presigned URL Expiry (in seconds)
PRESIGNED_URL_EXPIRY=3600
