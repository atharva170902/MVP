# Backend AWS credentials — copy to .env and fill in real values.
# NEVER commit the real .env file.
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key
AWS_REGION=ap-south-1

# ----------------------------------------------------------------
# AI question-paper generation (AWS Bedrock) — optional overrides
# ----------------------------------------------------------------
# Text model (no-image questions). Default is set in code.
# BEDROCK_TEXT_MODEL_ID=global.anthropic.claude-sonnet-4-5-20250929-v1:0
# Vision model (diagram questions). Set to an enabled Bedrock vision model id.
# BEDROCK_VISION_MODEL_ID=qwen.qwen2-vl-7b-instruct-v1:0
# Max parallel generation workers (thread-per-chapter fan-out).
# GEN_MAX_WORKERS=5

# ----------------------------------------------------------------
# Optional AI cost rates (USD per 1,000 tokens). When set, the job
# status snapshot includes a per-model + total dollar estimate.
# Standard AWS Bedrock on-demand pricing shown below.
# ----------------------------------------------------------------
# COST_RATE_SONNET_INPUT_PER_1K=0.003
# COST_RATE_SONNET_OUTPUT_PER_1K=0.015
# COST_RATE_QWEN_INPUT_PER_1K=0.00026
# COST_RATE_QWEN_OUTPUT_PER_1K=0.00104
# COST_RATE_TITAN_INPUT_PER_1K=0.00002
# COST_RATE_TITAN_OUTPUT_PER_1K=0
